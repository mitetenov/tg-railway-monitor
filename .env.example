# ── Telegram Ticket Monitor — Environment Configuration ───────────
# Copy this to .env and fill in your values.
#   cp .env.example .env && nano .env

# Required — bot token from @BotFather:
BOT_TOKEN=your_bot_token_here

# Optional — container timezone; affects log timestamps only.
# TZ=Asia/Tbilisi

# NOTE: route, date and seat class are NOT configured here. They are set
# per chat with /setroute, /setdate and /setclass and stored in
# data/{chat_id}.json.
