# Required: Telegram token from @BotFather.
BOT_TOKEN=your_bot_token_here

# Optional: storage directory (default ./data locally, /app/data in Docker).
# DATA_DIR=data

# Route, date and seat class are configured per chat with /start.
# Travel dates always use Asia/Tbilisi, independently of the host timezone.
# TICKET_SOURCE=trege  # tre.ge is also accepted.

# Optional API overrides for local integration tests or a changed public key.
# TRE_API_BASE=https://gateway.tkt.ge/integrations/api/GeorgianRailway
# TRE_API_KEY=...
# TELEGRAM_API_BASE=https://api.telegram.org
